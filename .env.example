# Environment variables for Agentic AI Application
# Copy this to .env and fill in actual values

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/agentic-ai-role
AWS_MAX_RETRIES=3
AWS_TIMEOUT_SECONDS=300

# Bedrock Configuration
# Model IDs: anthropic.claude-3-5-sonnet-20241022-v2:0, anthropic.claude-3-opus-20240229-v1:0
# amazon.nova-micro-v1:0, amazon.nova-lite-v1:0, amazon.nova-pro-v1:0
# amazon.titan-text-express-v1, amazon.titan-text-premier-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ENDPOINT=

# Semantic Kernel Configuration
SK_LOG_ENABLED=true
SK_LOG_LEVEL=INFO
SK_FUNCTION_CALL_RETRY_MAX_ATTEMPTS=3
SK_TIMEOUT_SECONDS=300

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.7
AGENT_TIMEOUT_SECONDS=600
AGENT_ENABLE_MEMORY=true
AGENT_MEMORY_TYPE=in_memory  # in_memory or redis

# Redis Configuration (if using redis memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Database Configuration (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_ai

# OpenTelemetry Configuration (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# API Configuration (optional)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_CREDENTIALS=true
